# Bytecode caches, unanchored because providers/ writes its own too
__pycache__/

# Ruff cache and the uv environment
/.ruff_cache/
/.venv/

# Generated catalogues: every run rewrites data/<id>.json, so nothing here is
# meant to be committed. Hand-saved captures live in data_templates/
/data/*

# Local keys, while .env.example stays tracked as the reference
.env
.env.local
.env.*.local

# Prettier and its dependencies
/node_modules/

# Qoder agent sessions and workflow transcripts
/.qoder/

# OS scratch files
Thumbs.db
desktop.ini
/.DS_Store
