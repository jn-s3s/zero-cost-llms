[
    {
        "id": "openrouter",
        "name": "OpenRouter",
        "homepage": "https://openrouter.ai",
        "signupUrl": "https://openrouter.ai/signup",
        "docsUrl": "https://openrouter.ai/docs",
        "api": {
            "baseUrl": "https://openrouter.ai/api/v1",
            "models": {
                "endpoint": "/models",
                "auth": false,
                "note": "Free models has `:free` suffix or `stealth` as prefix in its `data.id`"
            },
            "test": {
                "endpoint": "/chat/completions",
                "auth": true,
                "body": {
                    "model": "openrouter/free",
                    "messages": [{ "role": "user", "content": "Hi" }]
                }
            }
        },
        "other_source": [],
        "quota": {
            "type": "limited",
            "limits": {
                "rpm": 20,
                "tpm": null,
                "rpd": 50,
                "monthly": null,
                "notes": "Unlock 1000 RPD with $10+ credit"
            },
            "reset": {
                "cadence": "daily",
                "note": "Resets at midnight UTC"
            }
        },
        "requirement": {
            "key": true,
            "phone-verified": false,
            "linked-card": false
        },
        "ENV_VAR": "OPENROUTER_API_KEY"
    },
