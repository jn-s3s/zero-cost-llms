[
    {
        "id": "openrouter",
        "name": "OpenRouter",
        "keyEnvVar": "OPENROUTER_API_KEY",
        "keylessUsage": false,
        "requirement": {
            "login-method": "google-auth",
            "phone-verified": false,
            "linked-card": false,
            "linked-github": false
        },
        "api": {
            "baseUrl": "https://openrouter.ai/api/v1",
            "models": {
                "endpoint": "/models",
                "auth": false,
                "note": "Free models has `:free` suffix or `stealth` as prefix in `data[].id`"
            },
            "test": {
                "endpoint": "/chat/completions",
                "auth": true,
                "body": {
                    "model": "openrouter/free",
                    "messages": [{ "role": "user", "content": "Hi" }]
                }
            }
        },
        "quota": [
            {
                "type": "free",
                "limits": {
                    "rpm": 20,
                    "rpd": 50,
                    "notes": "New user without adding $10+ credits"
                },
                "reset": {
                    "cadence": "daily",
                    "note": "Resets at 00:00 UTC"
                }
            },
            {
                "type": "recharged-free",
                "limits": {
                    "rpm": 20,
                    "rpd": 1000,
                    "notes": "Limits increase for adding $10+ credits"
                },
                "reset": {
                    "cadence": "daily",
                    "note": "Resets at 00:00 UTC"
                }
            }
        ],
        "other_source": [
            {
                "url": "https://openrouter.ai/docs/api_reference/limits#rate-limits",
                "type": "reference",
                "auth": false,
                "note": "Page mentioning limits. RPM, RPD"
            },
            {
                "url": "https://www.reddit.com/r/openrouter/comments/1jeknm9/comment/mjwmwjg/",
                "type": "reference",
                "auth": false,
                "note": "Page mentioning rate limit reset time. X-RateLimit-Reset"
            }
        ],
        "channels": {
            "homepage": "https://openrouter.ai",
            "signup": "https://openrouter.ai/signup",
            "docs": "https://openrouter.ai/docs",
            "discord": "https://openrouter.ai/discord",
            "support": "https://openrouter.ai/support",
            "support-email": "support@openrouter.ai",
            "github": "https://github.com/OpenRouterTeam",
            "x": "https://x.com/OpenRouter",
            "linkedin": "https://www.linkedin.com/company/openrouter",
            "status": "https://status.openrouter.ai"
        }
    },
